<?xml version="1.0" encoding="utf-8" ?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
>
    <!-- 顶部导航栏容器 -->
    <LinearLayout
        android:id="@+id/top_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="@id/layout_root"
    >
        <LinearLayout
            android:id="@+id/top_btn_menu_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_top_menu"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_top_menu"
            />
            <TextView
                android:id="@+id/tv_top_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="菜单"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/top_btn_home_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_top_home"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_top_home"
            />
            <TextView
                android:id="@+id/tv_top_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主页"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/top_btn_add_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_top_add"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_top_add"
            />
            <TextView
                android:id="@+id/tv_top_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="增加"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/top_btn_search_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_top_search"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_top_search"
            />
            <TextView
                android:id="@+id/tv_top_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查找"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/top_btn_upload_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_top_upload"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_top_upload"
            />
            <TextView
                android:id="@+id/tv_top_upload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上传"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
            />
        </LinearLayout>
    </LinearLayout>
    <!-- 中间主Tab分类网格，数据由C++ QStringList驱动 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_maintab_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar_layout"
        app:layout_constraintBottom_toTopOf="@id/bottom_tab_layout"
    />
    <!-- 底部Tab栏容器 -->
    <LinearLayout
        android:id="@+id/bottom_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:background="#ffffff"
        app:layout_constraintBottom_toBottomOf="@id/layout_root"
    >
        <LinearLayout
            android:id="@+id/tab_read_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_tab_read"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab_read"
            />
            <TextView
                android:id="@+id/tv_tab_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="阅读"
                android:textSize="14sp"
                android:layout_marginTop="3dp"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_todo_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_tab_todo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab_todo"
            />
            <TextView
                android:id="@+id/tv_tab_todo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待办"
                android:textSize="14sp"
                android:layout_marginTop="3dp"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_note_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_tab_note"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab_note"
            />
            <TextView
                android:id="@+id/tv_tab_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="笔记"
                android:textSize="14sp"
                android:layout_marginTop="3dp"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_sport_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_tab_sport"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab_sport"
            />
            <TextView
                android:id="@+id/tv_tab_sport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运动"
                android:textSize="14sp"
                android:layout_marginTop="3dp"
            />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
