<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
>

    <!-- 卡片主体：侧边条 + 标题 + 内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
    >

        <View
            android:id="@+id/viewStripe"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
        />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
        >

            <TextView
                android:id="@+id/tv_todo_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
            />

            <TextView
                android:id="@+id/tv_todo_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
            />

        </LinearLayout>
    </LinearLayout>

    <!-- 选中才显示的操作按钮区域 -->
    <LinearLayout
        android:id="@+id/action_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
    >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
        >

            <ImageView
                android:id="@+id/iv_action_star"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:src="@drawable/ic_todo_star"
            />

            <ImageView
                android:id="@+id/iv_action_copy"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:src="@drawable/ic_todo_copy"
            />

            <ImageView
                android:id="@+id/iv_action_edit"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:src="@drawable/ic_todo_edit"
            />

            <ImageView
                android:id="@+id/iv_action_alarm"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:src="@drawable/ic_todo_alarm"
            />

            <ImageView
                android:id="@+id/iv_action_delete"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:clickable="true"
                android:src="@drawable/ic_todo_delete"
            />

        </LinearLayout>

        <Button
            android:id="@+id/tv_action_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="完成"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:clickable="true"
        />

    </LinearLayout>

</LinearLayout>
