<?xml version="1.0" encoding="utf-8" ?>
<!-- filename: item_myevent_date_group.xml -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/myevent_card_date_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
>
    <!-- 内部直接使用LinearLayout，不再使用ConstraintLayout -->
    <LinearLayout
        android:id="@+id/myevent_ll_date_group_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
    >

        <TextView
            android:id="@+id/myevent_tv_date_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2026‑08‑30 原始测试中文ABC"
            android:textSize="16sp"
            android:textStyle="bold"
        />

        <LinearLayout
            android:id="@+id/myevent_ll_date_stat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
        >

            <TextView
                android:id="@+id/myevent_tv_day_item_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="16sp"
            />

            <TextView
                android:id="@+id/myevent_tv_day_sum_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:layout_marginStart="24dp"
                android:textSize="16sp"
            />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
