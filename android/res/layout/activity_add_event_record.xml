<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#f4f4f4"
>

    <!-- 顶部标题栏，为Button，支持点击 -->
    <Button
        android:id="@+id/et_title"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#ff8822"
        android:text="增加：xx"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:elevation="0dp"
    />

    <!-- 三个按钮：取消、分类、确定 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
    >

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="取消"
            android:textSize="16sp"
        />

        <Button
            android:id="@+id/btn_category"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="分类"
            android:textSize="16sp"
        />

        <Button
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="确定"
            android:textSize="16sp"
        />
    </LinearLayout>

    <!-- 分类输入行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
    >

        <ImageView
            android:id="@+id/icon_category"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_category"
            android:scaleType="fitCenter"
        />

        <AutoCompleteTextView
            android:id="@+id/et_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入分类"
            android:inputType="text"
            android:textSize="18sp"
            android:completionThreshold="1"
        />

        <Button
            android:id="@+id/btn_clear_category"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="🗑"
        />
    </LinearLayout>

    <!-- 备注多行输入框 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
    >

        <ImageView
            android:id="@+id/icon_xq"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_xq"
            android:scaleType="fitCenter"
        />

        <EditText
            android:id="@+id/et_note"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:hint="输入备注"
            android:inputType="textMultiLine|textCapSentences"
            android:scrollbars="vertical"
            android:textSize="18sp"
        />

        <Button
            android:id="@+id/btn_clear_note"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="🗑"
        />
    </LinearLayout>

    <!-- 金额只读输入框 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
    >

        <ImageView
            android:id="@+id/icon_je"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_je"
            android:scaleType="fitCenter"
        />

        <EditText
            android:id="@+id/et_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint=""
            android:inputType="numberDecimal"
            android:focusable="false"
            android:clickable="false"
            android:textSize="18sp"
        />

        <Button
            android:id="@+id/btn_clear_amount"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="🗑"
        />
    </LinearLayout>

    <!-- 数字软键盘区域 -->
    <GridLayout
        android:id="@+id/num_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:useDefaultMargins="true"
        android:layout_marginTop="8dp"
    >

        <Button
            android:id="@+id/key_7"
            android:text="7"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />
        <Button
            android:id="@+id/key_8"
            android:text="8"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />
        <Button
            android:id="@+id/key_9"
            android:text="9"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />

        <Button
            android:id="@+id/key_4"
            android:text="4"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />
        <Button
            android:id="@+id/key_5"
            android:text="5"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />
        <Button
            android:id="@+id/key_6"
            android:text="6"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />

        <Button
            android:id="@+id/key_1"
            android:text="1"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />
        <Button
            android:id="@+id/key_2"
            android:text="2"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />
        <Button
            android:id="@+id/key_3"
            android:text="3"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />

        <Button
            android:id="@+id/key_0"
            android:text="0"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />
        <Button
            android:id="@+id/key_dot"
            android:text="."
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />
        <Button
            android:id="@+id/key_backspace"
            android:text="Del"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_columnWeight="1"
        />
    </GridLayout>

    <!-- 时间显示 + SeekBar滑块 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:background="#ececec"
    >

        <TextView
            android:id="@+id/tv_time_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="06:36:01"
            android:textSize="22sp"
            android:gravity="center"
        />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
        >
            <TextView
                android:id="@+id/tv_hour_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="时"
                android:textSize="20sp"
            />
            <SeekBar
                android:id="@+id/seek_hour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="23"
            />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
        >
            <TextView
                android:id="@+id/tv_minute_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分"
                android:textSize="20sp"
            />
            <SeekBar
                android:id="@+id/seek_minute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="59"
            />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
