<?xml version="1.0" encoding="utf-8" ?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_todo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
>
    <!-- 顶部Todo输入栏 -->
    <LinearLayout
        android:id="@+id/todo_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="@id/layout_todo_root"
    >
        <EditText
            android:id="@+id/et_todo_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/todo_input_hint"
            android:inputType="textMultiLine"
            android:maxLines="2"
            android:paddingVertical="10dp"
            android:paddingHorizontal="12dp"
        />
        <ImageView
            android:id="@+id/iv_todo_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_todo_add"
        />
        <ImageView
            android:id="@+id/iv_todo_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_todo_clear"
        />
    </LinearLayout>
    <!-- Todo列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_todo_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toBottomOf="@id/todo_input_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_tab_layout"
    />
    <!-- 底部Tab栏，与MainEntrance完全复用结构 -->
    <LinearLayout
        android:id="@+id/bottom_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@id/layout_todo_root"
    >
        <LinearLayout
            android:id="@+id/tab_read_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_tab_read"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab_read"
            />
            <TextView
                android:id="@+id/tv_tab_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_read"
                android:textSize="14sp"
                android:layout_marginTop="3dp"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_todo_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_tab_todo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab_todo"
            />
            <TextView
                android:id="@+id/tv_tab_todo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_todo"
                android:textSize="14sp"
                android:layout_marginTop="3dp"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_note_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_tab_note"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab_note"
            />
            <TextView
                android:id="@+id/tv_tab_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_note"
                android:textSize="14sp"
                android:layout_marginTop="3dp"
            />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_sport_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
        >
            <ImageView
                android:id="@+id/iv_tab_sport"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_tab_sport"
            />
            <TextView
                android:id="@+id/tv_tab_sport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_sport"
                android:textSize="14sp"
                android:layout_marginTop="3dp"
            />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
