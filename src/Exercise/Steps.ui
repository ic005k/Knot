               <property name="styleSheet">
                <string notr="true">/*QRadioButton::indicator {
    width: 25px;
    height: 25px;
    
    position: relative;
    left: 0px;
    right: 3px;
    top: 2px;
    bottom:4px;
}

QRadioButton::indicator:unchecked {
    image: url(:/res/nosel.png);
